[Unit]
Description=Generate Impersia journal summaries
After=network.target postgresql.service

[Service]
Type=oneshot
User=impersia
Group=impersia
WorkingDirectory=/opt/impersia-os/services/api
EnvironmentFile=/etc/impersia/api.env
ExecStart=/opt/impersia-os/services/api/.venv/bin/python run_journal_summaries.py
