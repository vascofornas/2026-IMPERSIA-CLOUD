[Unit]
Description=Impersia Platform API
After=network.target postgresql.service

[Service]
User=impersia
Group=impersia
WorkingDirectory=/opt/impersia-os/platform/services/api
EnvironmentFile=/etc/impersia/api.env
Environment=PLATFORM_CORS=https://impersia.cloud
Environment=PLATFORM_COOKIE_SECURE=1
ExecStart=/opt/impersia-os/platform/services/api/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8001
Restart=on-failure

[Install]
WantedBy=multi-user.target
