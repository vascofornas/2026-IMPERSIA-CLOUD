DATABASE_URL=postgresql://impersia:CAMBIAR@127.0.0.1/impersia
JWT_SECRET=CAMBIAR
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.impersia.cloud/auth/google/callback

# Correo para avisos (Google Workspace). Sin esto, no salen avisos por email.
# SMTP_PASSWORD tiene que ser una contraseña de aplicación de Google, no la de la cuenta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=impersia@impersia.cloud
SMTP_PASSWORD=CAMBIAR
SMTP_FROM="Impersia <impersia@impersia.cloud>"

# Solo esta cuenta puede entrar y usar el panel del motor LLM.
ADMIN_EMAIL=modestovasco@gmail.com

# OpenRouter (Fase A). La clave solo vive en el VPS, nunca en el repositorio.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://impersia.cloud
OPENROUTER_APP_NAME=Impersia OS
